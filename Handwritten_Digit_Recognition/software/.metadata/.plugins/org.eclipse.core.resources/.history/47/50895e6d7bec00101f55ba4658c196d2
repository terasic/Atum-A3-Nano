bool MIPI_Init(void){
    bool bSuccess;
    bSuccess = i2c_mipi_bridge.Open("/dev/i2c_mipi",0x0e);
    //mipi 7bit addr : 0x0e; 8it addr : 0x1c
    //camera 7bit addr : 0x36; 8it addr : 0x6c
    if (!bSuccess)
        printf("failed to init MIPI- Bridge i2c\r\n");

    usleep(50*1000);
    MipiBridgeInit();
    i2c_mipi_bridge.Close();
    usleep(500*1000);

    MipiCameraInit();
    MIPI_BIN_LEVEL(DEFAULT_LEVEL);
//    OV8865_FOCUS_Move_to(340);

    usleep(1000);

    return bSuccess;
}

/* Convert a Hex nibble into an ASCII character */
char HEX2ASCII (char HEX_IN)
{
  char a_TEMP, h_TEMP;

  // shift upper nibble down
  h_TEMP = HEX_IN;
  if (h_TEMP == 0x0A)
    a_TEMP = 'A';
  else if (h_TEMP == 0x0B)
    a_TEMP = 'B';
  else if (h_TEMP == 0x0C)
    a_TEMP = 'C';
  else if (h_TEMP == 0x0D)
    a_TEMP = 'D';
  else if (h_TEMP == 0x0E)
    a_TEMP = 'E';
  else if (h_TEMP == 0x0F)
    a_TEMP = 'F';
  else
    a_TEMP = 0x30 + h_TEMP;

  return a_TEMP;
}

void word2ascii (alt_u16 value)
{
    alt_putchar(HEX2ASCII(value >> 12));
    alt_putchar(HEX2ASCII((value >> 8) & 0x0F));
    alt_putchar(HEX2ASCII((value >> 4) & 0x0F));
    alt_putchar(HEX2ASCII((value     ) & 0x0F));
}

static volatile int frame_ready_flag  = 0;
// =============================================================
// VFW_isr - Video Frame Writer interrupt service routine.
//           Happens every time the VFW writes a frame
//           Acknowledge the buffer
//          PB[3]/S4 toggles Red FPGA_LED1 every press
//
void VFW_isr (void* context)
{

    //alt_u32 buffer_start_addr;

    //alt_putstr("In VFW IRQ\r\n");
	frame_ready_flag = 1;
    // Acknowledge the Buffer. No need for COMMIT
    IOWR_32DIRECT(VVP_VFW_0_BASE,VFW_BUFFER_ACKNOWLEDGE,0x00);  // BUFFER_ACKNOWLEDGE    // Clear the interrupt bit
    IOWR_32DIRECT(VVP_VFW_0_BASE,VFW_IRQ_STATUS,0x01);  // IRQ_STATUS
}

/****************************************************************************/
// read_ai_register : Read a register from the AI Interface
//   reg_addr : Register address (see ONE_AI_* defines)
//   Returns the 32-bit register value
/****************************************************************************/
alt_u32 read_ai_register(alt_u8 reg_addr)
{
    alt_u32 reg_value;

    // Read from AI Interface - address is in bytes, but interface expects register offset
    reg_value = IORD_32DIRECT(ONE_AI_INTERFACE_0_BASE, reg_addr * 4);

    return reg_value;
}

/****************************************************************************
// dword2decimal : Convert 32-bit value to decimal ASCII representation
****************************************************************************/
void dword2decimal(alt_u32 value)
{
    char buffer[11]; // Max 10 digits for 32-bit + null terminator
    int i = 0;

    // Handle zero case
    if (value == 0) {
        alt_putchar('0');
        return;
    }

    // Convert to string (reverse order)
    while (value > 0) {
        buffer[i++] = '0' + (value % 10);
        value /= 10;
    }

    // Print in correct order
    while (i > 0) {
        alt_putchar(buffer[--i]);
    }
}

void uart_putstr(FILE *fp, const char *s)
{
    if (!fp || !s) return;
    fputs(s, fp);
    fflush(fp);
}

void dword2decimal_uart(alt_u32 value)
{
    char buffer[11];
    int i = 0;

    if (!fp) return;

   // Handle zero case
    if (value == 0) {
        fputc('0', fp);
        fflush(fp);
        return;
    }

    // Convert to string (reverse order)
    while (value > 0 && i < 10) {
        buffer[i++] = '0' + (value % 10);
        value /= 10;
    }

    // Print in correct order
    while (i > 0) {
        fputc(buffer[--i], fp);
    }
    fflush(fp);
}


/****************************************************************************/
// display_ai_status : Display AI Interface status information
/****************************************************************************/
void display_ai_status(void)
{
    alt_u32 new_image_ready, outputs_count, fps;
    alt_u32 width_height, objects_classes;

    // Read basic status registers
    new_image_ready = read_ai_register(ONE_AI_NEW_IMAGE_READY);

    outputs_count = read_ai_register(ONE_AI_OUTPUTS_COUNT);
    fps = read_ai_register(ONE_AI_FPS);
    width_height = read_ai_register(ONE_AI_USER_WIDTH_HEIGHT);
    objects_classes = read_ai_register(ONE_AI_USER_OBJECTS_CLASSES);

    alt_putstr("\r\n=== AI Interface Status ===\r\n");
    alt_putstr("New Image Ready: ");
    dword2decimal(new_image_ready & 0x1);
    alt_putstr("\r\nOutputs Count: ");
    dword2decimal(outputs_count);
    alt_putstr("\r\nFPS: ");
    dword2decimal(fps);
    alt_putstr("\r\nCurrent Width: ");
    dword2decimal(width_height & 0xFFFF);
    alt_putstr("\r\nCurrent Height: ");
    dword2decimal((width_height >> 16) & 0xFFFF);
    alt_putstr("\r\nCurrent Objects: ");
    dword2decimal(objects_classes & 0xFFFF);
    alt_putstr("\r\nCurrent Classes: ");
    dword2decimal((objects_classes >> 16) & 0xFFFF);

    // Also show first 10 CNN outputs in Data format
    alt_putstr("\r\n--- CNN Data Values ---\r\n");

    // Reset position to start from class 0
    IOWR_32DIRECT(ONE_AI_INTERFACE_0_BASE, ONE_AI_USER_OBJECTS_CLASSES * 4, 0);  // Reset to class 0
    usleep(1000);

    // Read and display 10 CNN values
    for(int i = 0; i < 10; i++)
    {
        alt_u32 cnn_value = read_ai_register(ONE_AI_OUTPUT_READ_AUTO);  // Address 0x04
        alt_putstr("Data ");
        dword2decimal(i);
        alt_putstr(": ");
        dword2decimal(cnn_value);
        alt_putstr("\r\n");
    }

    alt_putstr("===========================\r\n");
}

