/****************************************************************************/
// display_cnn_outputs : Display CNN output values using sequential auto-increment
/****************************************************************************/
void display_cnn_outputs(void)
{
    alt_u32 cnn_value;
    int i;

    alt_putstr("\r\n=== CNN Output Values ===\r\n");

    // Reset position to start from class 0
    IOWR_32DIRECT(ONE_AI_INTERFACE_0_BASE, ONE_AI_USER_OBJECTS_CLASSES * 4, 0);  // Reset to class 0
    usleep(1000);

    // Read 10 classes by reading address 0x04 multiple times
    for(i = 0; i < 10; i++)
    {
        // Each read from address 0x04 automatically increments to next class
        cnn_value = read_ai_register(ONE_AI_OUTPUT_READ_AUTO);  // Address 0x04
        alt_putstr("Data ");
        dword2decimal(i);
        alt_putstr(": ");
        dword2decimal(cnn_value);
        alt_putstr("\r\n");
    }
    alt_putstr("==========================\r\n");
}

/****************************************************************************/
// test_cnn_addressing_methods : Test both CNN addressing methods
/****************************************************************************/
void test_cnn_addressing_methods(void)
{
    alt_u32 cnn_value;
    int i;

    alt_putstr("\r\n=== Testing CNN Addressing Methods ===\r\n");

    // Method 1: Write offset, then read single value
    alt_putstr("Method 1 - Write offset + single read (0x20 + 0x03):\r\n");
    for(i = 0; i < 10; i++)
    {
        // Write class offset to objects/classes register (upper 16 bits = classes)
        IOWR_32DIRECT(ONE_AI_INTERFACE_0_BASE, ONE_AI_USER_OBJECTS_CLASSES * 4, (i << 16) | 0);

        // Small delay for register update
        usleep(1000);

        // Read single value from address 0x03
        cnn_value = read_ai_register(ONE_AI_OUTPUT_READ);  // Address 0x03
        alt_putstr("Offset ");
        dword2decimal(i);
        alt_putstr(" -> Class ");
        dword2decimal(i);
        alt_putstr(": ");
        dword2decimal(cnn_value);
        alt_putstr("\r\n");
    }

    alt_putstr("\r\nMethod 2 - Multiple reads from address 0x04 (auto-increment):\r\n");

    // Reset position to start from class 0
    IOWR_32DIRECT(ONE_AI_INTERFACE_0_BASE, ONE_AI_USER_OBJECTS_CLASSES * 4, 0);  // Reset to class 0
    usleep(1000);

    for(i = 0; i < 10; i++)
    {
        // Each read from address 0x04 automatically increments to next class
        cnn_value = read_ai_register(ONE_AI_OUTPUT_READ_AUTO);  // Address 0x04
        alt_putstr("Read ");
        dword2decimal(i + 1);
        alt_putstr(" from 0x04 -> Class ");
        dword2decimal(i);
        alt_putstr(": ");
        dword2decimal(cnn_value);
        alt_putstr("\r\n");
    }
    alt_putstr("=====================================\r\n");
}

