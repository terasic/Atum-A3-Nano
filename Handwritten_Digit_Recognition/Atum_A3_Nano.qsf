#============================================================
# Build by Terasic System Builder
#============================================================

set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CZ135BB18AE7S
set_global_assignment -name TOP_LEVEL_ENTITY "Atum_A3_Nano"
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "24.3"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1.0 Pro Edition"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "17:01:34 Ò»ÔÂ 08,2026"
set_global_assignment -name DEVICE_FILTER_PACKAGE VPBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 7839644
set_global_assignment -name IP_FILE ip/TERASIC_CAMERA/rgb_fifo.ip
set_global_assignment -name IP_FILE ip/TERASIC_CAMERA/Bayer_LineBuffer.ip
set_global_assignment -name IP_FILE ip/TERASIC_CAMERA/add4.ip
set_global_assignment -name IP_FILE ip/TERASIC_CAMERA/add2.ip
